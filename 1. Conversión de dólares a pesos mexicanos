algoritmo Dolares_pesos ()
inicio 
  //DECLARACIONES
  definir dolares, tipoCambio, pesos como real

  //CUERPO
  tipoCambio = 18.49
  escribir "ingrese la cantidad de dolares"
  leer dolares

  //CALCULO
  pesos = dolares * tipoCambio

  //RESULTADO
  Escribir "Equivale a ", pesos, " pesos mexicanos"
fin

//CORRIDA MANUAL 
ingrese la cantidad de dolares
100
tipoCambio = 18.49
pesos = 100 * 18.49 = 1849
Equivale a 1849 pesos mexicanos
