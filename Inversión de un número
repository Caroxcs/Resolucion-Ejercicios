algoritmo InversionNumero ()
inicio 
    // DECLARACION
    Definir num, inv, dig Como Entero
    
    // CUERPO
    inv <- 0
    Escribir "Ingrese numero:"
    Leer num
    
    // CALCULO
    Mientras num > 0 Hacer
        dig <- num MOD 10
        inv <- (inv * 10) + dig
        num <- TRUNC(num / 10)
    FinMientras
    
    // RESULTADO
    Escribir "Invertido: ", inv
FinAlgoritmo

