algoritmo Multiplos3y5 ()
inicio   
  //DECLARACIONES 
    Definir n, i, cont, suma Como Entero
    
    // CUERPO
    cont <- 0
    suma <- 0
    Escribir "Ingrese N:"
    Leer n
    
    // CALCULO
    i <- 1
    Mientras i <= n Hacer
        Si (i MOD 3 = 0) O (i MOD 5 = 0) Entonces
            cont <- cont + 1
            suma <- suma + i
        FinSi
        i <- i + 1
    FinMientras
    
    // RESULTADO
    Escribir "Cantidad: ", cont, " Suma: ", suma
FinAlgoritmo


