algoritmo Precio_final ()
inicio 
  //DECLARACIONES
  definir precio, conDescuento, iva, precioFinal como real

  //CUERPO
  escribir "ingrese el precio original"
  leer precio 

  //CALCULO
  conDescuento = precio * 0.80
  iva = conDescuento * 0,15
  precioFinal = conDescuento + iva

  //RESULTADO
  escribir "Precio con descuento: ", conDescuento 
  escribir "Precio final: ", precioFinal
fin 

//CORRIDA MANUAL
ingrese el precio original
100
conDescuento = 100 * 0.80 = 80
iva = 80 * 0.15 = 12
precioFinal = 80 + 12 = 92
Precio con descuento: 80
Precio final: 92
