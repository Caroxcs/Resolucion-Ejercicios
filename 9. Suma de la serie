algoritmo SumaSerie ()
inicio 
  //DECLARACIONES 
    Definir n, i Como Entero
    Definir suma Como Real
    
    // CUERPO
    suma <- 0
    Escribir "Ingrese N:"
    Leer n
    
    // CALCULO
    Para i <- 1 Hasta n Con Paso 1 Hacer
        suma <- suma + (1.0 / i)
    FinPara
    
    // RESULTADO
    Escribir "Suma: ", suma
FinAlgoritmo

//CORRIDA MANUAL
Datos: n=3. 
Cálculo: i=1(sum=1), i=2(sum=1.5), i=3(sum=1.83).
Resultado: 1.83.
