algoritmo Estacion ()
inicio
  //DECLARACIONES 
  definir mes, dia como entero 

  //CUERPO 
  escribir "ingrese el mes"
  leer mes 
  escribir "ingreese el dia"
  leer dia 

  //CALCULO
  f = mes * 100 + dia
    Si (f >= 1221) O (f <= 320) Entonces
      Escribir "Verano"
    Sino
      Si f <= 620 Entonces
        Escribir "Otoño"
      Sino
        Si f <= 922 Entonces
          Escribir "Invierno"
        Sino
          Escribir "Primavera"
        FinSi
      FinSi
    FinSi
Fin

