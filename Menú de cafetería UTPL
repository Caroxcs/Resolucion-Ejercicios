Algoritmo MenuCafeteria
    // DECLARACIONES
    Definir opcion Como Entero
    
    // ENTRADA DE DATOS
    Escribir "--- MENÚ CAFETERÍA UTPL ---"
    Escribir "1. Café ($1.50)"
    Escribir "2. Jugo ($1.20)"
    Escribir "3. Sandwich ($2.50)"
    Escribir "4. Salir"
    Escribir "Seleccione una opción: "
    Leer opcion
    
    // CÁLCULO Y SALIDA (Switch)
    Segun opcion Hacer
        1: Escribir "Producto: Café. Precio: $1.50"
        2: Escribir "Producto: Jugo. Precio: $1.20"
        3: Escribir "Producto: Sandwich. Precio: $2.50"
        4: Escribir "¡Gracias por su visita! Saliendo..."
        De Otro Modo: Escribir "Opción inválida."
    FinSegun
FinAlgoritmo

//CORRIDA MANUAL
Entrada 1 
Salida: Producto: Café. Precio: $1.50.
