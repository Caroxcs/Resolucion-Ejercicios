algoritmo bono_productividad ()
inicio
  //DECLARACIONES 
  definir sueldo, productividad, porcentaje, bono, total como real 

  //CUERPO 
  escribir "ingresar el sueldo base"
  leer sueldo 
  escribir "productividad"
  leer productividad
  Si productividad >= 90 Entonces
    porcentaje <- 20;
  Sino
    Si productividad >= 70 Entonces
      porcentaje <- 10;
    Sino
      Si productividad >= 50 Entonces
        porcentaje <- 5;
      Sino
        porcentaje <- 0;
      FinSi
   FinSi
  FinSi

  //CALCULO 
  bono <- sueldo * porcentaje / 100;
  total <- sueldo + bono;

  //RESULTADO
  Escribir "Bono: ", bono;
  Escribir "Total a pagar: ", total;
Fin

