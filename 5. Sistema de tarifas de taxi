algoritmo tarifa_taxi ()
inicio 
  //DECLARACIONES
  definir km, base, total como real 
  definir noche como caracter

  //CUERPO
  escribir "ïngrese los kilometros"
  leer km
  escribir "esta de noche?"
  leer noche 

  //CALCULO
  base = 2.00 + 1.50 * km
  total = base
  si km > 10 entonces 
    total = total + base * 0.20
  finSi
  si noche = "s" entonces 
    total = total + base * 0.30
  finSi 

  //RESULTADO 
  escribir "tarifa base:", base
  escribir "total pagar: ", total 
fin 


//CORRIDA MANUAL
