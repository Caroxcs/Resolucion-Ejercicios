Algoritmo Conversión_decimal_hexadecimal ()
inicio
  //DECLARACIONES
  Definir num, residuo como Entero
  Definir hex, digito como Cadena

  //CUERPO
  Escribir "Ingrese un número decimal entero:"
  Leer num
  Si num == 0 Entonces
     hex <- "0"
  Sino
     hex <- ""
     Mientras num > 0 Hacer
       residuo <- num MOD 16
          Si residuo < 10 Entonces
              digito <- ConvertirATexto(residuo)
          Sino
              Segun residuo Hacer
                10: digito <- "A"
                11: digito <- "B"
                12: digito <- "C"
                13: digito <- "D"
                14: digito <- "E"
                15: digito <- "F"
              FinSegun
          FinSi
          hex <- digito + hex
          num <- trunc(num / 16)
      FinMientras
  FinSi   
  Escribir "El número en hexadecimal es: ", hex
FinProceso

